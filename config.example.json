{
  "dry_run": true,
  "http_timeout": "30s",
  "state_file": "/var/lib/arr-reconciler/state.json",

  "instances": [
    {
      "name": "sonarr",
      "kind": "sonarr",
      "base_url": "http://sonarr:8989",
      "api_key": "REPLACE_WITH_SONARR_API_KEY"
    },
    {
      "name": "radarr",
      "kind": "radarr",
      "base_url": "http://radarr:7878",
      "api_key": "REPLACE_WITH_RADARR_API_KEY"
    }
  ],

  "queue": {
    "stalled_threshold": "2h",
    "max_removals_per_run": 25,
    "max_candidates_per_run": 200,
    "batch_size": 50,
    "grace_runs": 2,
    "blocklist": true
  },

  "safety": {
    "delete_enabled": false,
    "trash_dataset": "/tank/trash",
    "trash_ttl": "336h",
    "max_deletes_per_run": 50,
    "max_bytes_per_run": 536870912000,
    "min_orphan_age": "6h",
    "max_candidates_per_run": 500,
    "batch_size": 50,
    "rules_disabled": false,
    "allowed_roots": [
      "/tank/media/movies",
      "/tank/media/tv"
    ],
    "protected_extensions": [".nfo", ".srt", ".sub", ".ass", ".jpg", ".png", ".txt"]
  },

  "claude": {
    "api_key": "REPLACE_WITH_ANTHROPIC_API_KEY",
    "model": "claude-sonnet-4-6",
    "queue_model": "claude-haiku-4-5",
    "orphan_model": "claude-sonnet-4-6",
    "max_tokens": 4096,
    "base_url": "https://api.anthropic.com",
    "gateway_token": "",
    "cache_ttl": "1h"
  },

  "notify": {
    "webhook_url": ""
  },

  "llmobs": {
    "endpoint": "http://datadog-agent:8126",
    "ml_app": "arr-reconciler",
    "tags": ["env:home", "stack:media"]
  },

  "local": {
    "endpoint": "http://ollama:11434",
    "model": "qwen2.5:3b",
    "timeout": "1m"
  }
}
